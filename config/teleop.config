<?xml version="1.0"?>
<gazebo>
  <!-- Set the display parameters (adjust the window size, background, etc.) -->
  <gui>
    <!-- Set the window width and height -->
    <window_width>1280</window_width>
    <window_height>720</window_height>

    <!-- Enable/Disable GUI features -->
    <show_grid>true</show_grid>
    <show_axes>true</show_axes>
    <show_camera_controls>true</show_camera_controls>

    <!-- Set the path to background image (optional) -->
    <background_image>/path/to/your/background/image.png</background_image>
  </gui>

  <!-- Other GUI settings (e.g., enable specific plugins, etc.) -->
  <plugins>
    <!-- Example of enabling some plugins -->
    <plugin filename="libgazebo_ros_state_plugin.so"/>
  </plugins>
</gazebo>
